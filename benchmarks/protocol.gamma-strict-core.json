{
  "schema_version": 1,
  "protocol_version": "0.1.0",
  "purpose": "stratascan_0_1_0_release_matrix",
  "parameter_mode": "fixed_predeclared_profiles",
  "resources": {"threads": 1, "timeout_seconds": 300, "memory_limit_mb": 8192},
  "methods": ["StrataSCAN"],
  "stochastic_methods": ["StrataSCAN"],
  "method_parameters": {
    "min_samples": 5,
    "min_cluster_size": 5,
    "dense_core_quantile": 0.95,
    "tail_probe_score": "d4/d32",
    "tail_probe_quantile": 0.02,
    "tail_probe_alpha": 0.05,
    "tail_core_quantile": 0.05,
    "border_multiplier": 1.25
  },
  "synthetic": {
    "quality_seeds": [23, 42, 73], "scaling_seeds": [42],
    "quality_sizes": [20000], "scaling_sizes": [],
    "cases": [
      {"id": "multidensity_2d", "family": "multidensity", "dimension": 2, "noise_fraction": 0.75},
      {"id": "ultrasparse_16d", "family": "ultrasparse", "dimension": 16, "noise_fraction": 0.95},
      {"id": "overlapping_density_16d", "family": "overlapping_density", "dimension": 16, "noise_fraction": 0.80, "signal_fraction": 0.20},
      {"id": "moons_2d", "family": "moons", "dimension": 2, "noise_fraction": 0.25},
      {"id": "rings_2d", "family": "rings", "dimension": 2, "noise_fraction": 0.75},
      {"id": "overlap_8d", "family": "gaussian_overlap", "dimension": 8, "noise_fraction": 0.25},
      {"id": "imbalanced_16d", "family": "gaussian_imbalanced", "dimension": 16, "noise_fraction": 0.75}
    ]
  },
  "cytometry": {
    "seeds": [42],
    "datasets": [
      {"id": "levine", "features": "data/processed/levine/features.csv", "feature_metadata": "data/processed/levine/feature_metadata.csv", "feature_classes": ["type"], "transform": {"name": "arcsinh", "cofactor": 5.0}, "metadata": "data/processed/levine/event_metadata.csv", "label_column": "population_id", "background_labels": ["unassigned"]}
    ]
  },
  "gaia": {
    "seeds": [42],
    "data_root": "data/raw/mctnc/MCTNC_open_data_release/MCTNC_open_data_release/data",
    "profiles": ["unsupervised_field"],
    "field_selection": {"strategy": "stable_hash", "count": 24, "salt": "stratascan-realtime-v1"},
    "ruwe_max": 1.6
  }
}
