{
  "schema_version": 1,
  "protocol_version": "target-discovery-v1",
  "matching": {
    "strategy": "hungarian",
    "objective": "pairwise_f1",
    "unmatched_target_score": 0.0
  },
  "aggregation": {
    "primary": "macro_over_targets",
    "diagnostic": "target_size_weighted",
    "samusik_study_weighting": "equal_weight_per_study"
  },
  "discovery_thresholds": {
    "purity": 0.9,
    "coverage": 0.1
  },
  "fragment_min_target_fraction": 0.05,
  "failure_policy": {
    "timeout_error_memory_limit": "retain_status_and_missing_quality",
    "exclude_from_success_only_runtime": true,
    "retain_in_completion_denominator": true
  },
  "suites": {
    "synthetic": {
      "mode": "full_partition",
      "background_semantics": "known_synthetic_noise"
    },
    "cytometry": {
      "mode": "full_partition",
      "background_semantics": "heterogeneous_biological_background",
      "dataset_overrides": {
        "mosmann": {"mode": "target_discovery"},
        "nilsson": {"mode": "target_discovery"}
      }
    },
    "gaia": {
      "mode": "target_discovery",
      "background_semantics": "reference_negative_background"
    }
  }
}
