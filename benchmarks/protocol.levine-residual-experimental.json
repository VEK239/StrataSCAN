{
  "schema_version": 1,
  "protocol_version": "experimental-levine-intrinsic-multistratum-residual-v2",
  "purpose": "levine_only_experimental_residual_stratascan",
  "parameter_mode": "fixed_predeclared_experimental_profile",
  "resources": {
    "threads": 1,
    "timeout_seconds": 600,
    "memory_limit_mb": 8192
  },
  "methods": ["StrataSCAN-Residual"],
  "stochastic_methods": ["StrataSCAN-Residual"],
  "method_parameters": {
    "k": 32,
    "intrinsic_dimension": true,
    "retain_intermediate_components": true,
    "background_components": 1,
    "background_posterior_threshold": 0.5,
    "max_passes": 2,
    "accepted_cluster_size": 20,
    "residual_max_cluster_fraction": 0.20,
    "projection_components": null
  },
  "synthetic": {
    "quality_seeds": [42],
    "scaling_seeds": [],
    "quality_sizes": [],
    "scaling_sizes": [],
    "cases": []
  },
  "cytometry": {
    "seeds": [23, 42, 73],
    "datasets": [
      {
        "id": "levine",
        "features": "data/processed/levine/features.csv",
        "feature_metadata": "data/processed/levine/feature_metadata.csv",
        "feature_classes": ["type"],
        "transform": {"name": "arcsinh", "cofactor": 5.0},
        "metadata": "data/processed/levine/event_metadata.csv",
        "label_column": "population_id",
        "background_labels": ["unassigned"]
      }
    ]
  },
  "gaia": {
    "seeds": [42],
    "data_root": "data/raw/mctnc/MCTNC_open_data_release/MCTNC_open_data_release/data",
    "profiles": [],
    "ruwe_max": 1.6
  }
}
