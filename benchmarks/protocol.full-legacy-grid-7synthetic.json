{
  "schema_version": 1,
  "protocol_version": "0.1.0-full-legacy-grid-7synthetic",
  "purpose": "stratascan_0_1_0_full_legacy_density_grid_with_7_current_synthetic_cases",
  "parameter_mode": "fixed_predeclared_profiles",
  "resources": {
    "threads": 1,
    "timeout_seconds": 600,
    "memory_limit_mb": 8192
  },
  "methods": [
    "DBSCAN",
    "HDBSCAN",
    "OPTICS",
    "SNN-DBSCAN",
    "VDBSCAN-2007",
    "AMD-DBSCAN",
    "kNN-DBSCAN",
    "kNN+Leiden",
    "StrataSCAN"
  ],
  "stochastic_methods": ["kNN+Leiden", "StrataSCAN"],
  "method_parameters": {
    "min_samples": 5,
    "min_cluster_size": 5,
    "dense_core_quantile": 0.95,
    "tail_probe_score": "d4/d32",
    "tail_probe_quantile": 0.02,
    "tail_probe_alpha": 0.05,
    "tail_core_quantile": 0.05,
    "border_multiplier": 1.25
  },
  "synthetic": {
    "quality_seeds": [23, 42, 73, 101, 151],
    "scaling_seeds": [42],
    "quality_sizes": [5000, 20000, 50000],
    "scaling_sizes": [100000, 200000],
    "cases": [
      {"id": "multidensity_2d", "family": "multidensity", "dimension": 2, "noise_fraction": 0.75},
      {"id": "ultrasparse_16d", "family": "ultrasparse", "dimension": 16, "noise_fraction": 0.95},
      {"id": "overlapping_density_16d", "family": "overlapping_density", "dimension": 16, "noise_fraction": 0.80, "signal_fraction": 0.20},
      {"id": "moons_2d", "family": "moons", "dimension": 2, "noise_fraction": 0.25},
      {"id": "rings_2d", "family": "rings", "dimension": 2, "noise_fraction": 0.75},
      {"id": "overlap_8d", "family": "gaussian_overlap", "dimension": 8, "noise_fraction": 0.25},
      {"id": "imbalanced_16d", "family": "gaussian_imbalanced", "dimension": 16, "noise_fraction": 0.75}
    ]
  },
  "cytometry": {
    "seeds": [23, 42, 73],
    "datasets": [
      {
        "id": "levine",
        "features": "data/processed/levine/features.csv",
        "feature_metadata": "data/processed/levine/feature_metadata.csv",
        "feature_classes": ["type"],
        "transform": {"name": "arcsinh", "cofactor": 5.0},
        "metadata": "data/processed/levine/event_metadata.csv",
        "label_column": "population_id",
        "background_labels": ["unassigned"]
      },
      {
        "id": "mosmann",
        "features": "data/processed/mosmann/features.csv",
        "feature_metadata": "data/processed/mosmann/feature_metadata.csv",
        "feature_classes": ["type"],
        "transform": {"name": "arcsinh", "cofactor": 150.0},
        "metadata": "data/processed/mosmann/event_metadata.csv",
        "label_column": "population_id",
        "background_labels": ["other"]
      },
      {
        "id": "nilsson",
        "features": "data/processed/nilsson/features.csv",
        "feature_metadata": "data/processed/nilsson/feature_metadata.csv",
        "feature_classes": ["type"],
        "transform": {"name": "arcsinh", "cofactor": 150.0},
        "metadata": "data/processed/nilsson/event_metadata.csv",
        "label_column": "population_id",
        "background_labels": ["other"]
      }
    ]
  },
  "gaia": {
    "seeds": [23, 42, 73],
    "data_root": "data/raw/mctnc/MCTNC_open_data_release/MCTNC_open_data_release/data",
    "profiles": ["unsupervised_field"],
    "ruwe_max": 1.6
  }
}
