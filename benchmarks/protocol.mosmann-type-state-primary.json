{
  "schema_version": 1,
  "protocol_version": "v0.2.4-target-discovery-v1-mosmann-type-state-primary",
  "purpose": "replace the primary Mosmann type-only panel with the biologically aligned type-plus-state panel for every compared method",
  "parameter_mode": "v0.2.4_frozen_method_profiles_with_primary_mosmann_type_plus_state_panel",
