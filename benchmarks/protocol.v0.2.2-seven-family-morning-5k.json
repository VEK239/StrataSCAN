{
  "schema_version": 1,
  "protocol_version": "0.2.2-seven-family-morning-5k-v1",
  "purpose": "Parallel morning-quality snapshot: the five missing 5k cells of the seven-family primary benchmark. Combine with the preserved serial v2 5k results for multidensity_2d and ultrasparse_16d to obtain a complete seven-family 5k snapshot.",
  "parameter_mode": "released_defaults_and_unchanged_controlled_baseline_profiles_fixed_before_execution_parallel_quality_snapshot",
  "resources": {
    "threads": 1,
    "timeout_seconds": 1200,
    "memory_limit_mb": 8192,
    "parallel_workers": 4,
    "resource_reporting_note": "Quality and completion results are valid. Wall-clock runtime and peak-RSS results are not publishable serial resource measurements because jobs run concurrently."
  },
  "methods": [
    "DBSCAN",
    "HDBSCAN",
    "OPTICS",
    "SNN-DBSCAN",
    "VDBSCAN-2007",
    "AMD-DBSCAN",
    "kNN-DBSCAN",
    "kNN+Leiden",
    "StrataSCAN"
  ],
  "stochastic_methods": ["kNN+Leiden", "StrataSCAN"],
  "synthetic": {
    "quality_seeds": [23, 42, 73, 101, 151],
    "quality_sizes": [5000],
    "scaling_seeds": [],
    "scaling_sizes": [],
    "cases": [
      {
        "id": "overlapping_density_16d",
        "family": "overlapping_density",
        "dimension": 16,
        "noise_fraction": 0.8,
        "signal_fraction": 0.2
      },
      {
        "id": "moons_2d",
        "family": "moons",
        "dimension": 2,
        "noise_fraction": 0.25
      },
      {
        "id": "rings_2d",
        "family": "rings",
        "dimension": 2,
        "noise_fraction": 0.75
      },
      {
        "id": "overlap_8d",
        "family": "gaussian_overlap",
        "dimension": 8,
        "noise_fraction": 0.25
      },
      {
        "id": "imbalanced_16d",
        "family": "gaussian_imbalanced",
        "dimension": 16,
        "noise_fraction": 0.75
      }
    ]
  },
  "analysis": {
    "metrics": ["macro_target_f1", "noise_f1", "pairwise_f1", "runtime_seconds", "peak_rss_mb"],
    "expected_records": 225,
    "publication_note": "Do not use this run's runtime or peak-RSS values for serial resource comparison figures."
  }
}
