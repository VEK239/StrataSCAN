{
  "title": "PILOT / replicated topology and density stress benchmark",
  "schema_version": 1,
  "geometry_seed": 3571,
  "sampling_seeds": [23, 42, 73, 151],
  "methods": ["StrataSCAN", "DBSCAN", "HDBSCAN", "OPTICS", "kNN-DBSCAN", "SNN-DBSCAN", "VDBSCAN-2007", "kNN+Leiden", "AMD-DBSCAN"],
  "max_workers": 4,
  "timeout_seconds": 240,
  "design": {
    "target_count": 6,
    "mass_per_target": 300,
    "minimum_local_contrast_at_99pct": 50.0,
    "background_support": "fixed axis-aligned square shared by all topologies",
    "background_sampling": "nested prefix by topology and sampling seed"
  },
  "cells": [
    {"cell_id": "gaussian_noise_curve_r4", "topology": "compact_gaussian", "density_ratio": 4.0, "noise_fractions": [0.50, 0.75, 0.90, 0.95, 0.975, 0.99]},
    {"cell_id": "anisotropic_ellipses_screen", "topology": "anisotropic_ellipses", "density_ratio": 1.0, "noise_fractions": [0.75, 0.95, 0.99]},
    {"cell_id": "moon_arcs_screen", "topology": "moon_arcs", "density_ratio": 1.0, "noise_fractions": [0.75, 0.95, 0.99]},
    {"cell_id": "rings_screen", "topology": "rings", "density_ratio": 1.0, "noise_fractions": [0.75, 0.95, 0.99]},
    {"cell_id": "gaussian_density_r16", "topology": "compact_gaussian", "density_ratio": 16.0, "noise_fractions": [0.95, 0.99]},
    {"cell_id": "gaussian_density_r64", "topology": "compact_gaussian", "density_ratio": 64.0, "noise_fractions": [0.95, 0.99]}
  ],
  "resource_policy": {
    "amd_dbscan": "always_skip",
    "reason": "AMD-DBSCAN's compatibility path is O(n^2) and is explicitly skipped for every cell in this n=3,600 to 180,000 replicated benchmark."
  }
}
